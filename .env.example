# Same database as the api. The api owns the schema: jobs never migrates.
# With docker compose the host is `db:5432`; from the host machine `localhost:5433`.
DATABASE_URL=postgresql://gioco:gioco@localhost:5433/gioco

# Optional: enables the integration tests (`go test ./...`). Must be a database migrated by the api.
TEST_DATABASE_URL=postgresql://gioco:gioco@localhost:5433/gioco_test

# Kafka carries the battle resolution queue written by the api. Comma-separated list of brokers.
# With docker compose `kafka:9092`; from the host machine `localhost:29092`.
KAFKA_BROKERS=localhost:29092
# Topic of the battle queue (created by the `kafka-init` service of docker compose) and consumer group.
KAFKA_BATTLE_TOPIC=battle.resolve
KAFKA_GROUP_ID=gioco-jobs

# Optional: enables the Kafka integration test (`go test ./...`).
TEST_KAFKA_BROKERS=localhost:29092

# Directory shared with the api where uploaded geo files are stored.
UPLOAD_DIR=./uploads

# How often an idle worker looks for a new job, in milliseconds.
JOBS_POLL_MS=1000
# Number of jobs processed in parallel.
JOBS_WORKERS=4
# Attempts before a job is marked FAILED.
JOBS_MAX_ATTEMPTS=5
# A job RUNNING for longer than this (seconds) is considered abandoned and requeued.
JOBS_STALE_AFTER_SEC=300

# Processing of uploaded boundaries. Distances are in metres.
# Detail lost by the geometry used on the map.
GEO_SIMPLIFY_TOLERANCE_M=50
# Widest gap between two borders that still counts as contact.
GEO_ADJACENCY_GAP_M=5
# Shortest shared border that makes two municipalities adjacent (a corner contact is not enough).
GEO_ADJACENCY_MIN_BORDER_M=50

# Log level: debug, info, warn, error.
LOG_LEVEL=info
